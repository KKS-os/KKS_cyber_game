# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (DO NOT PUT REAL SECRETS IN THIS FILE)
# Copy this file to .env.local for local testing, or add to GitHub / Vercel secrets.
# ==============================================================================

# Gemini AI Studio Runtime (Automatically provided in AI Studio)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="https://your-game.vercel.app"

# Firebase Cloud Firestore & Auth (Optional overrides for GitHub / Vercel deployments)
# If not provided, the game automatically uses firebase-applet-config.json
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
